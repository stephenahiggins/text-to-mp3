{
  "expo": {
    "name": "Reading Stacks",
    "slug": "article-stacks",
    "scheme": "articlestacks",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.articlestacks.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Find your Mac automatically and send saved articles and PDFs over Wi-Fi.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSBonjourServices": [
          "_readingstacks._tcp"
        ]
      }
    },
    "android": {
      "package": "com.articlestacks.mobile",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a stack transfer QR code on your Mac.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-document-picker",
      "expo-sqlite",
      "./plugins/withShareExtension"
    ],
    "icon": "./assets/reading-stacks.png"
  }
}
